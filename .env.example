# Copy to .env and adjust. Never commit real credentials.
# These variables are read by docker-compose.yml (dev database).
POSTGRES_USER=eduportal
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=eduportal
POSTGRES_PORT=5432

# JWT secrets (must also be set in server/.env for the NestJS backend)
JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
