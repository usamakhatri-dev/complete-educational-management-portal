# Copy to .env and adjust for your environment
NODE_ENV=development
PORT=3000

# Database (PostgreSQL via Docker Compose — see docker-compose.yml / root .env)
# Placeholder credentials; never commit real secrets.
DATABASE_URL="postgresql://eduportal:change-me-in-production@localhost:5432/eduportal?schema=public"

# Auth — CHANGE THESE in production
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS=7
ACCESS_TOKEN_TTL_SECONDS=900

# Frontend
CORS_ORIGINS="http://localhost:5173"

# Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=10
